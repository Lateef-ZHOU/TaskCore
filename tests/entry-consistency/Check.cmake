cmake_minimum_required(VERSION 3.28)
file(REAL_PATH "${FAMILY_SOURCE}" FAMILY_SOURCE)
set(other_source "${FAMILY_SOURCE}")
if(CASE MATCHES "^(identical_copy|changed_header|changed_build|incremental_change)$")
    set(other_source "${TEST_ROOT}/copy")
    file(MAKE_DIRECTORY "${other_source}")
    file(COPY "${FAMILY_SOURCE}/CMakeLists.txt" "${FAMILY_SOURCE}/include"
        "${FAMILY_SOURCE}/optional" "${FAMILY_SOURCE}/cmake" "${FAMILY_SOURCE}/models"
        DESTINATION "${other_source}")
    if(CASE STREQUAL "changed_header")
        file(APPEND "${other_source}/include/DAQFamily/DAQChannelSpec.h" "\n// Different source fixture.\n")
    elseif(CASE STREQUAL "changed_build")
        file(APPEND "${other_source}/CMakeLists.txt" "\n# Different build fixture.\n")
    endif()
endif()
file(MAKE_DIRECTORY "${TEST_ROOT}/project")
file(WRITE "${TEST_ROOT}/project/CMakeLists.txt" "cmake_minimum_required(VERSION 3.28)\nproject(EntryConsistency LANGUAGES CXX)\n")
set(project "${TEST_ROOT}/project/CMakeLists.txt")
if(CASE STREQUAL "unknown_target")
    file(APPEND "${project}" "add_library(ExternalModels INTERFACE)\nadd_library(Lidar::FamilyModels ALIAS ExternalModels)\n")
elseif(CASE STREQUAL "full_first")
    file(APPEND "${project}" "add_subdirectory(\"${FAMILY_SOURCE}\" family)\n")
else()
    file(APPEND "${project}" "add_subdirectory(\"${FAMILY_SOURCE}/models\" models-first)\n")
endif()
if(CASE STREQUAL "full_first")
    file(APPEND "${project}" "add_subdirectory(\"${other_source}/models\" models-second)\n")
else()
    file(APPEND "${project}" "add_subdirectory(\"${other_source}\" family)\n")
endif()
file(APPEND "${project}" "if(NOT TARGET Lidar::FamilyModels OR NOT TARGET Lidar::FamilyCore)\nmessage(FATAL_ERROR \"Both entries must be present\")\nendif()\n")
set(command "${CMAKE_COMMAND}" -S "${TEST_ROOT}/project" -B "${TEST_ROOT}/build"
    -C "${DEPENDENCY_CACHE}" -G "${GENERATOR}")
if(PLATFORM)
    list(APPEND command -A "${PLATFORM}")
endif()
execute_process(COMMAND ${command} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(WRITE "${TEST_ROOT}/configure.log" "${out}\n${err}")
if(CASE MATCHES "^(changed_header|changed_build|unknown_target)$")
    if(result EQUAL 0 OR NOT "${out}${err}" MATCHES "FamilyCore source mismatch")
        message(FATAL_ERROR "${CASE}: expected the source mismatch diagnostic, got ${result}\n${out}\n${err}")
    endif()
elseif(NOT result EQUAL 0)
    message(FATAL_ERROR "${CASE}: configuration failed\n${out}\n${err}")
endif()
if(CASE STREQUAL "incremental_change")
    file(APPEND "${other_source}/include/DAQFamily/DAQChannelSpec.h" "\n// Changed after configuration.\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${TEST_ROOT}/build" --config Release
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    file(WRITE "${TEST_ROOT}/incremental.log" "${out}\n${err}")
    if(result EQUAL 0 OR NOT "${out}${err}" MATCHES "FamilyCore source mismatch")
        message(FATAL_ERROR "Incremental build must recheck source identity\n${out}\n${err}")
    endif()
endif()
message(STATUS "${CASE}: passed")
